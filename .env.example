# Social Media Archiver - Environment Variables Example
# Copy this to .env and fill in your values

# Reddit official API (optional; public RSS is the fallback)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Facebook official Graph API (required for Facebook targets)
# FB_GRAPH_TOKEN=
# FB_GRAPH_VERSION=25.0

# S3-compatible storage (only when storage.backend is "s3")
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=eu-west-2
